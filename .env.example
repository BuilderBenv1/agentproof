# ===========================================
# AgentProof Environment Configuration
# ===========================================

# Avalanche
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
PRIVATE_KEY=your_deployer_private_key_here
SNOWTRACE_API_KEY=your_snowtrace_api_key

# Contract Addresses — Core (populated after deployment)
IDENTITY_REGISTRY_ADDRESS=
REPUTATION_REGISTRY_ADDRESS=
VALIDATION_REGISTRY_ADDRESS=
AGENTPROOF_CORE_ADDRESS=

# Contract Addresses — Phase 3 (populated after deployment)
INSURANCE_POOL_ADDRESS=
AGENT_PAYMENTS_ADDRESS=
REPUTATION_GATE_ADDRESS=
REPUTATION_SOURCE_ADDRESS=

# Official ERC-8004 Registries (Ava Labs)
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REPUTATION_REGISTRY=0x8004B663056A597Dffe9eCcC1965A193B7388713
USE_OFFICIAL_ERC8004=true

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_AVALANCHE_RPC=https://api.avax-test.network/ext/bc/C/rpc
NEXT_PUBLIC_IDENTITY_REGISTRY=
NEXT_PUBLIC_REPUTATION_REGISTRY=
NEXT_PUBLIC_VALIDATION_REGISTRY=
NEXT_PUBLIC_CHAIN_ID=43113
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# EVM Chains (optional — set RPC URLs for chains you want to index)
# All use same CREATE2 contract addresses: Identity 0x8004A169..., Reputation 0x8004BAa1...
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
SCROLL_RPC_URL=
GNOSIS_RPC_URL=
MANTLE_RPC_URL=
CELO_RPC_URL=
MONAD_RPC_URL=
ABSTRACT_RPC_URL=
TAIKO_RPC_URL=
MEGAETH_RPC_URL=
SKALE_RPC_URL=
XLAYER_RPC_URL=
SONEIUM_RPC_URL=
METIS_RPC_URL=

# Solana (non-EVM)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=                               # Optional: hex-encoded 32-byte Ed25519 seed for Solana signing (falls back to ORACLE_PRIVATE_KEY)

# GitHub (optional — enables coding agent reputation)
GITHUB_TOKEN=                                  # GitHub PAT for polling agent repos

# Indexer
INDEXER_POLL_INTERVAL=10
INDEXER_CONFIRMATION_BLOCKS=3
